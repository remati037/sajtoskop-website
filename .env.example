# ─── Sajt ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sajtoskop.com

# ─── CTA prekidač ────────────────────────────────────────────────────────────
# waitlist = forma za mejl na landingu (default, koristi se dok app nije spreman)
# signup   = sva CTA dugmad vode na registraciju u aplikaciji
NEXT_PUBLIC_CTA_MODE=waitlist
NEXT_PUBLIC_APP_URL=https://app.sajtoskop.com

# ─── Društvene mreže (opciono; prazno = ikonica se ne prikazuje) ─────────────
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# ─── Supabase — upis prijava sa beta liste ───────────────────────────────────
# Service role ključ NIKAD ne sme da ima NEXT_PUBLIC_ prefiks.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend — mejl notifikacije ──────────────────────────────────────────────
# RESEND_FROM mora biti adresa na domenu verifikovanom u Resend-u.
RESEND_API_KEY=
RESEND_FROM=Sajtoskop <zdravo@sajtoskop.com>
NOTIFY_EMAIL=marko2000.dev@gmail.com
